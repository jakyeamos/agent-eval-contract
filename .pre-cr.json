{
  "version": 1,
  "testCommand": "uv run --with pytest python scripts/pre_cr_coverage.py",
  "coveragePaths": [
    ".pre-cr/coverage.lcov"
  ],
  "coverageFormat": "lcov",
  "threshold": 0,
  "qualityCommands": [
    "uv run ruff check agent_eval_contract scripts tests",
    "uv run ruff format --check agent_eval_contract scripts tests",
    "uv run basedpyright agent_eval_contract scripts tests",
    "uv run pytest -q",
    "uv run --with vulture vulture agent_eval_contract scripts tests --min-confidence 70",
    "uv build --out-dir /tmp/agent-eval-contract-dist",
    "python3 scripts/check_environment_contract.py"
  ],
  "qualityAdapters": [
    {
      "name": "environment-contract",
      "command": "python3 scripts/check_environment_contract.py",
      "required": true
    }
  ],
  "surfaces": {
    "covered": [
      "agent_eval_contract/**"
    ],
    "ignored": [
      ".gitignore",
      ".pre-cr.json",
      "CHANGELOG.md",
      "README.md",
      "RELEASE.md",
      "pyproject.toml",
      "scripts/**",
      "uv.lock",
      "tests/**",
      "examples/**"
    ],
    "unsupported": []
  },
  "checks": {
    "coverage": true,
    "security": true,
    "checklist": true
  }
}
